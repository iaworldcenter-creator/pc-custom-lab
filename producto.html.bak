<!-- DELIVERY ADDRESS MODAL (GLASSMORPHISM) -->
<div class="fixed inset-0 z-[300] hidden flex items-center justify-center bg-slate-950/80 px-4" id="deliveryModal">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative text-slate-100">
        <h2 class="text-lg font-black text-white mb-2 flex items-center gap-2">
            <i class="fa-solid fa-map-location-dot text-cyan-400"></i> Registrar Domicilio de Entrega
        </h2>
        <p class="text-[11px] text-slate-400 mb-4 leading-relaxed">
            ⚠️ <strong>Nota:</strong> Servicio disponible únicamente a no más de <strong>5 km de distancia</strong> de nuestra sucursal Centro.
        </p>
        <form onsubmit="saveDeliveryAddress(event)" class="flex flex-col gap-3">
            <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Nombre Completo</label>
                <input type="text" id="deliveryName" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Teléfono</label>
                    <input type="tel" id="deliveryPhone" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                </div>
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Correo Electrónico</label>
                    <input type="email" id="deliveryEmail" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                </div>
            </div>
            <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Calle y Número</label>
                <input type="text" id="deliveryStreet" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Colonia</label>
                    <input type="text" id="deliveryColonia" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                </div>
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Ciudad / Estado</label>
                    <input type="text" id="deliveryCity" required value="Guadalajara, Jalisco" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                </div>
            </div>
            <div class="flex justify-end gap-2.5 mt-2">
                <button type="button" onclick="closeDeliveryModal()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-4 py-2 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-5 py-2 rounded-xl text-xs transition cursor-pointer">Registrar</button>
            </div>
        </form>
    </div>
</div>

<!-- PAYMENT METHOD MODAL -->
<div class="fixed inset-0 z-[300] hidden flex items-center justify-center bg-slate-950/80 px-4" id="paymentMethodModal">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative text-slate-100 flex flex-col gap-4">
        <h2 class="text-lg font-black text-white flex items-center gap-2">
            <i class="fa-solid fa-credit-card text-cyan-400"></i> Registrar Forma de Pago
        </h2>
        <div class="grid grid-cols-2 gap-3">
            <button onclick="savePaymentMethod('Efectivo')" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-400 transition cursor-pointer">
                <i class="fa-solid fa-money-bill-1 text-emerald-400 text-2xl"></i>
                <span class="text-xs font-bold">Efectivo local</span>
            </button>
            <button onclick="savePaymentMethod('Kueski')" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-400 transition cursor-pointer">
                <i class="fa-solid fa-bolt text-amber-400 text-2xl"></i>
                <span class="text-xs font-bold">Kueski Pay</span>
            </button>
            <button onclick="savePaymentMethod('Transferencia')" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-400 transition cursor-pointer">
                <i class="fa-solid fa-building-columns text-blue-400 text-2xl"></i>
                <span class="text-xs font-bold">Transferencia</span>
            </button>
            <button onclick="document.getElementById('payment-card-form').classList.remove('hidden')" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-400 transition cursor-pointer">
                <i class="fa-solid fa-credit-card text-purple-400 text-2xl"></i>
                <span class="text-xs font-bold">Tarjeta</span>
            </button>
        </div>
        <form id="payment-card-form" onsubmit="confirmCardPayment(event)" class="hidden border-t border-slate-800 pt-4 flex flex-col gap-3">
            <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Número de Tarjeta</label>
                <input type="text" id="cardNumber" placeholder="1234 5678 1234 5678" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Vencimiento</label>
                    <input type="text" id="cardExpiry" placeholder="MM/AA" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                </div>
                <div>
                    <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">CVV</label>
                    <input type="text" id="cardCvv" placeholder="123" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-1">
                <button type="button" onclick="closePaymentModal()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-4 py-2 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-5 py-2 rounded-xl text-xs transition cursor-pointer">Confirmar</button>
            </div>
        </form>
    </div>
</div>

<!-- ORDERS HISTORY MODAL -->
<div class="fixed inset-0 z-[300] hidden flex items-center justify-center bg-slate-950/80 px-4" id="ordersHistoryModal">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-xl w-full shadow-2xl relative text-slate-100 flex flex-col gap-4">
        <div class="flex justify-between items-center border-b border-slate-800 pb-3 mb-1">
            <h3 class="text-base font-black text-white flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-cyan-400"></i> Historial de Mis Pedidos</h3>
            <button class="text-slate-400 hover:text-white cursor-pointer text-xl" onclick="closeOrdersModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="flex flex-col gap-4 max-h-[60vh] overflow-y-auto pr-1" id="orders-modal-content">
            <!-- Rendered dynamically -->
        </div>
    </div>
</div>

<!-- CHATBOT FLOTANTE -->
<div class="fixed bottom-6 right-6 z-[9999] text-slate-100 font-sans">
    <button aria-label="Botón del chatbot" onclick="toggleChatbot()" class="w-14 h-14 rounded-full bg-cyan-500 hover:bg-cyan-400 flex items-center justify-center shadow-lg shadow-cyan-500/20 active:scale-95 transition cursor-pointer relative z-[10000]">
        <i class="fa-solid fa-comments text-2xl text-slate-950"></i>
    </button>
    <div id="chatbot-window" class="hidden absolute bottom-16 right-0 w-80 bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col justify-between">
        <div class="bg-slate-950 border-b border-slate-800 px-4 py-3 flex items-center gap-2">
            <div class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></div>
            <span class="text-xs font-black text-white">Soporte IA Copilot</span>
        </div>
        <div id="chat-messages" class="flex-grow p-4 flex flex-col gap-3 overflow-y-auto text-[11px] max-h-[350px]">
            <div class="bg-slate-950 border border-slate-800 p-2.5 rounded-2xl text-slate-300">
                Hola, soy el asistente IA del Ecosistema de Tiendas. ¿En qué puedo ayudarte hoy sobre este producto?
            </div>
        </div>
        <div class="p-3 border-t border-slate-800 flex gap-2">
            <input type="text" id="chatInput" placeholder="Pregunta algo..." onkeypress="handleChatKeyPress(event)" class="flex-grow bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
            <button onclick="enviarMensajeChatbot()" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-3 rounded-xl text-xs cursor-pointer"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>
</div>

<!-- CART DRAWER -->
<div class="fixed inset-0 z-[250]" id="cartDrawer" style="display: none !important;">
    <div class="absolute inset-0 bg-slate-950/60 cursor-pointer" onclick="closeCartDrawerAndGoToBoutique()"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col justify-between text-slate-100 p-6 transition-transform duration-300">
        <div>
            <div class="flex justify-between items-center border-b border-slate-800 pb-4 mb-6">
                <h3 class="text-base font-black text-white flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-cyan-400"></i> Tu Carrito de Compras</h3>
                <button class="text-2xl text-slate-400 hover:text-white cursor-pointer" onclick="closeCartDrawer()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="bg-slate-950/40 border border-slate-800 rounded-xl p-4 mb-4 flex flex-col gap-2.5">
                <div class="flex justify-between items-center text-xs">
                    <span class="text-slate-400 font-bold">Registro de Entrega: <span id="drawer-delivery-status" class="text-cyan-400 font-bold">Pendiente</span></span>
                    <button onclick="openDeliveryModal()" class="text-cyan-400 hover:underline font-bold focus:outline-none">(Editar)</button>
                </div>
                <div class="flex justify-between items-center text-xs">
                    <span class="text-slate-400 font-bold">Forma de Pago: <span id="drawer-payment-status" class="text-cyan-400 font-bold">No seleccionada</span></span>
                    <button onclick="openPaymentModal()" class="text-cyan-400 hover:underline font-bold focus:outline-none">(Editar)</button>
                </div>
            </div>
            <div class="flex flex-col gap-4 overflow-y-auto max-h-[45vh] pr-1" id="drawer-cart-items"></div>
        </div>
        <div class="border-t border-slate-800 pt-4 mt-4 flex flex-col gap-4">
            <div class="flex flex-col gap-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-slate-400 font-bold">Productos:</span>
                    <span class="text-white font-bold" id="drawer-total-qty">0</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400 font-bold">Subtotal:</span>
                    <span class="text-white font-bold" id="drawer-subtotal">$0.00 MXN</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400 font-bold">Envío:</span>
                    <span class="text-white font-bold" id="drawer-shipping">$0.00 MXN</span>
                </div>
                <div class="flex justify-between items-center border-t border-slate-800 pt-2 mt-2">
                    <span class="text-slate-300 font-black text-sm uppercase">Total:</span>
                    <span class="text-lg font-black text-cyan-400" id="drawer-total-cost">$0.00 MXN</span>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <button class="bg-slate-850 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:text-white font-bold py-3 rounded-xl text-xs transition cursor-pointer active:scale-95" onclick="closeCartDrawerAndGoToBoutique()">
                    <i class="fa-solid fa-arrow-left"></i> Seguir comprando
                </button>
                <a class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-3 rounded-xl text-xs text-center transition flex items-center justify-center gap-1.5 cursor-pointer active:scale-95" href="checkout.html" id="drawer-checkout-btn">
                    Comprar ahora <i class="fa-solid fa-credit-card"></i>
                </a>
            </div>
        </div>
    </div>
</div>

