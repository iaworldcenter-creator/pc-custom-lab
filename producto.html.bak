<script>


    function updateHeaderDeliveryPrompt() {
        const promptDiv = document.getElementById("header-delivery-prompt");
        if (!promptDiv) return;
        const stored = localStorage.getItem("user_delivery_address");
        // Check if we are inside pc-custom-lab (uses relative path for checkout)
        const isPcCustomLab = window.location.pathname.includes("pc-custom-lab");
        const checkoutUrl = isPcCustomLab ? "checkout.html" : "checkout.html";
        
        if (stored) {
            const data = JSON.parse(stored);
            promptDiv.innerHTML = `<i class="fa-solid fa-location-dot text-emerald-400 animate-bounce"></i> <span class="text-emerald-400 font-bold">Enviar a ${data.name.split(' ')[0]} (${data.city.split(',')[0]})</span>`;
        } else {
            promptDiv.innerHTML = `<i class="fa-solid fa-circle-exclamation text-amber-500 animate-pulse"></i> <span class="text-amber-500 font-black uppercase tracking-wider text-[9px] bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">¡Registra tu domicilio de entrega aquí!</span>`;
        }
        promptDiv.classList.remove("hidden");
    }
    
    // Auto-run on load
    document.addEventListener("DOMContentLoaded", () => {
        updateHeaderDeliveryPrompt();
    });

</script>
